# ZYRVA Agents - exemplo para desenvolvimento local
# Copie para .env e altere apenas o necessário. Nunca comite o arquivo .env.

# demo: usa adaptadores simulados e dados fictícios; production: exige provedores reais.
APP_MODE=demo

# Gere valores novos antes de qualquer ambiente compartilhado ou produção.
# AUTH_SECRET: pelo menos 32 bytes aleatórios.
AUTH_SECRET=change-me-local-demo-auth-secret

# A conta abaixo existe somente quando APP_MODE=demo.
DEMO_USER_EMAIL=leonardo@zyrva.demo
DEMO_USER_PASSWORD=ZyrvaDemo!2026

# Ao executar a aplicação no computador e apenas banco/Redis no Docker, use localhost.
DATABASE_URL=postgresql://zyrva:zyrva_local_only@localhost:5432/zyrva?schema=public
REDIS_URL=redis://localhost:6379

# Ajustes exclusivos do Docker Compose local. Não reutilize esta senha em produção.
POSTGRES_DB=zyrva
POSTGRES_USER=zyrva
POSTGRES_PASSWORD=zyrva_local_only
POSTGRES_PORT=5432
REDIS_PORT=6379
APP_PORT=3000

# OpenAI. A chave fica vazia no modo demo.
OPENAI_API_KEY=
OPENAI_MODEL_RUNTIME=gpt-5.6-terra
OPENAI_MODEL_BUILDER=gpt-5.6-terra
OPENAI_MODEL_EMBEDDINGS=text-embedding-3-small

# Meta WhatsApp Cloud API. Todos estes valores ficam vazios no modo demo.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_CHANNEL_ORGANIZATION_ID=
META_CHANNEL_COMPANY_ID=
META_CHANNEL_AGENT_ID=
META_CHANNEL_LABEL=WhatsApp principal
# Use a versão vigente informada no painel/documentação da Meta, por exemplo vXX.X.
META_GRAPH_API_VERSION=

# Operação local
TZ=America/Fortaleza
LOG_LEVEL=info
# Produção exige true e um ingress confiável que sobrescreva X-Forwarded-For.
TRUST_PROXY=false

# Em produção com mais de uma instância Next.js, defina a mesma chave Base64 de
# 16, 24 ou 32 bytes durante o build e em todas as instâncias de runtime.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
